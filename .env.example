# Copy to `.env` and fill in. `.env` is git-ignored and must stay that way —
# the deployed site never reads this file, it reads Netlify's own environment
# variables. This exists only so `netlify dev` can run the payment functions
# on your machine.
#
#   cp .env.example .env
#   netlify dev
#
# Test keys start rzp_test_ and move no money. Live keys start rzp_live_ and
# are generated separately once KYC is approved.

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Only needed to test the webhook, which needs a public URL anyway —
# leave blank unless you are running `netlify dev --live`.
RAZORPAY_WEBHOOK_SECRET=

# Optional. Without these the order email is skipped and nothing breaks.
RESEND_API_KEY=
ORDER_EMAIL_FROM=The Olive Branch <onboarding@resend.dev>
